{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"DOMAINS": "cortech.online,dmarc.mx,q-r.contact,donthype.me",
		"EMAIL_ADDRESSES": [],
		// WebAuthn step-up Relying Party config (issue #376). RP_ID is the
		// effective domain the passkey is scoped to; RP_ORIGIN is the exact
		// https origin the assertion must come from. Both are validated against
		// the request origin on every verify — they MUST match the deployed
		// hostname or every assertion is rejected.
		"RP_ID": "inbox.cortech.online",
		"RP_ORIGIN": "https://inbox.cortech.online",
		// Optional AAGUID authenticator allowlist for WebAuthn step-up enrollment
		// (issue #506). Comma-separated authenticator AAGUIDs; with a non-empty
		// list, register/verify rejects any authenticator whose AAGUID is not on
		// it. Empty (the default here) ⇒ allow all (no change from #376).
		// Operator-configured, not teammate-editable settings.
		"WEBAUTHN_AAGUID_ALLOWLIST": ""
		// Operator security-alert webhook for first-passkey (TOFU) enrollment
		// (issue #376) is set as a SECRET, not a var here — a literal var would
		// widen the generated `Cloudflare.Env` and break `Env extends Cloudflare.Env`
		// (see workers/types.ts). Configure with:
		//   wrangler secret put SECURITY_ALERT_WEBHOOK_URL
		// When unset, the first-key alert dispatch no-ops (the audit log still fires).
		//
		// Ops-visibility "new mail" webhook (issue #563) is also a SECRET, not a
		// var here, for the same reason. Configure with:
		//   wrangler secret put NEW_EMAIL_WEBHOOK_URL
		// Per-tier destinations use the same NEW_EMAIL_WEBHOOK_ prefix and are
		// named from a settings-tier `newEmailWebhook` block; see docs/secrets.md.
		// When unset, no new-mail chat notification is sent.
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BLOOM_KV",
			"id": "ebaf7dd6b5514eeba2ea319cdb587f78",
			"preview_id": "f2e485845c114bc0b09976c3213df016"
		}
	],
	// WebAuthn credential + challenge store (issue #376). First D1 in the
	// project; schema lives in migrations/webauthn (already applied to this
	// database — re-apply elsewhere with
	// `wrangler d1 migrations apply phishsoc-webauthn --remote`).
	"d1_databases": [
		{
			"binding": "WEBAUTHN_DB",
			"database_name": "phishsoc-webauthn",
			"database_id": "6b995b64-642f-4da6-a0c1-aae2a24e5825",
			"migrations_dir": "migrations/webauthn"
		}
	],
	"triggers": {
		"crons": [
			// Refresh threat-intel feeds hourly. Individual feeds respect their
			// own refreshHours via ETag caching — the cron just wakes the worker.
			"0 * * * *",
			// Sidecar mailbox poll (issue #31). No-ops (one R2 list) when no
			// mailbox has a `sidecar` settings block.
			"* * * * *"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			},
			{
				"name": "ORG_AGENT",
				"class_name": "OrgAgent"
			},
			{
				"name": "CATCHALL_INTEL",
				"class_name": "CatchallIntelDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"OrgAgent"
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"CatchallIntelDO"
			]
		}
	]
}
