		"vitest": "^5.0.3",
		"wrangler": "^4.146.0"
	},
	"overrides": {
		"undici": "^7.29.0",
		"ws": "^8.21.0",
		"esbuild": "^0.28.1",
		"vite@>=8.0.0 <8.0.16": "^8.0.16",
		"sharp": "^0.35.4"
